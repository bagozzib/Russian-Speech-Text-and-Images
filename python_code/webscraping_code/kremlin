def clean_text(s: str) -> str:
    if not s:
        return ""
    s = html.unescape(s)
    s = re.sub(r"\r\n|\r", "\n", s)
    s = re.sub(r"[ \t\u00A0]+", " ", s)
    s = re.sub(r"\n{3,}", "\n\n", s)
    return s.strip()


def strip_trailing_garbage(txt: str) -> str:
    if not txt:
        return txt
    txt = re.sub(r"\s*(?:\u2026)\s*[\'\"”»]*\s*$", "", txt)
    txt = txt.rstrip(' \t\r\n\u00A0\u200B\u200C\u200D\u2060\ufeff\uFFFD<>«»“”"\'·•…—–-')
    return txt.strip()


def hash_bytes(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def is_thumbnail_like(u: str) -> bool:
    if not u:
        return False
    low = u.lower()
    # do NOT treat /small/ as thumbnail; we use it as fallback
    return any(p in low for p in ("/thumb", "/preview", "/mini/"))


def uniq_in_order(seq: Iterable[str]) -> List[str]:
    seen = set()
    out = []
    for x in seq:
        if x and x not in seen:
            seen.add(x)
            out.append(x)
    return out


def make_size_variants(u: str) -> List[str]:
    """
    Prefer larger variants when Kremlin uses size folders.
    Order: original -> inferred big2x/big/small -> original (fallback)
    """
    if not u:
        return []
    cand: List[str] = []

    if "/small2x/" in u:
        cand += [u.replace("/small2x/", "/big2x/"), u.replace("/small2x/", "/big/")]
    if "/small/" in u:
        cand += [u.replace("/small/", "/big2x/"), u.replace("/small/", "/big/")]
    if "/big/" in u:
        cand += [u.replace("/big/", "/big2x/"), u.replace("/big/", "/small/")]
    if "/big2x/" in u:
        cand += [u.replace("/big2x/", "/big/"), u.replace("/big2x/", "/small/")]

    cand = [u] + cand + [u]
    return uniq_in_order(cand)


def norm_url(base_url: str, u: str) -> Optional[str]:
    if not u:
        return None
    u = html.unescape(u.strip()).strip("'\"")
    if u.startswith("//"):
        u = "https:" + u
    return urljoin(base_url, u)


def best_from_srcset(base_url: str, srcset: str) -> Optional[str]:
    if not srcset:
        return None
    best_url, best_metric = None, -1.0
    for part in srcset.split(","):
        m = SRCSET_PART_RE.match(part.strip())
        if not m:
            continue
        url_raw, num, unit = m.groups()
        url_abs = norm_url(base_url, url_raw)
        if not url_abs:
            continue
        metric = float(num) if num else 1.0
        if unit == "x":
            metric *= 10000.0
        if metric > best_metric:
            best_metric = metric
            best_url = url_abs
    return best_url


def safe_bs4(html_text: str) -> BeautifulSoup:
    try:
        return BeautifulSoup(html_text, "lxml")
    except Exception:
        return BeautifulSoup(html_text, "html.parser")


# ---------------------------
# HTTP client with optional proxy rotation
# ---------------------------

class HttpClient:
    def __init__(self, cfg: Config):
        self.cfg = cfg
        self.session = requests.Session()
        self.headers = build_headers(cfg.accept_language)

        adapter = requests.adapters.HTTPAdapter(max_retries=0)
        self.session.mount("http://", adapter)
        self.session.mount("https://", adapter)

        self._last_proxy_switch = 0.0
        self._proxy_idx = -1

        if self.cfg.proxy_mode == "rotating" and not self.cfg.proxy_list:
            print("[proxy] proxy_mode=rotating but proxy_list empty -> using proxy_mode=none")
            self.cfg.proxy_mode = "none"

        self._switch_proxy(force=True)

    def _format_proxy_dict(self, proxy_url: str) -> Dict[str, str]:
        if not proxy_url:
            return {}
        return {"http": proxy_url, "https": proxy_url}

    def _switch_proxy(self, force: bool = False) -> None:
        now = time.monotonic()
        if not force and (now - self._last_proxy_switch) < self.cfg.rotate_every_seconds:
            return

        if self.cfg.proxy_mode == "none":
            self.session.proxies = {}
        elif self.cfg.proxy_mode == "static":
            self.session.proxies = self._format_proxy_dict(self.cfg.static_proxy)
        elif self.cfg.proxy_mode == "rotating":
            self._proxy_idx = (self._proxy_idx + 1) % len(self.cfg.proxy_list)
            self.session.proxies = self._format_proxy_dict(self.cfg.proxy_list[self._proxy_idx])
        else:
            self.session.proxies = {}

        self._last_proxy_switch = now

    def request(self, method: str, url: str, **kwargs) -> requests.Response:
        self._switch_proxy(force=False)
        last_exc = None
        r: Optional[requests.Response] = None

        for attempt in range(self.cfg.max_transport_retries):
            try:
                r = self.session.request(
                    method,
                    url,
                    headers=self.headers,
                    timeout=self.cfg.timeout,
                    allow_redirects=True,
                    **kwargs
                )
                if (
                    r is not None
                    and r.status_code in self.cfg.block_statuses
                    and self.cfg.proxy_mode in ("static", "rotating")
                ):
                    print(f"[proxy] {method} {url} -> {r.status_code}, rotate + retry ({attempt+1}/{self.cfg.max_transport_retries})")
                    self._switch_proxy(force=True)
                    continue
                return r
            except requests.RequestException as e:
                last_exc = e
                if self.cfg.proxy_mode in ("static", "rotating"):
                    print(f"[proxy] NET error {method} {url}: {e}. rotate + retry ({attempt+1}/{self.cfg.max_transport_retries})")
                    self._switch_proxy(force=True)
                    continue
                raise

        if r is not None:
            return r
        if last_exc:
            raise last_exc
        raise RuntimeError("request failed with no response and no exception")


