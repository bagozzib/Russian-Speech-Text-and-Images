def remove_dir_if_exists(dst_dir: str) -> None:
    if os.path.isdir(dst_dir):
        try:
            shutil.rmtree(dst_dir)
        except Exception:
            pass


def purge_images_dir(dst_dir: str) -> None:
    if os.path.isdir(dst_dir):
        for fn in os.listdir(dst_dir):
            if fn.lower().endswith((".jpg", ".jpeg", ".png")):
                try:
                    os.remove(os.path.join(dst_dir, fn))
                except Exception:
                    pass


def download_image_bytes(client: HttpClient, url: str) -> Tuple[bytes, str]:
    r = client.request("GET", url, stream=False)
    r.raise_for_status()
    return r.content, (r.headers.get("Content-Type", "") or "")


def choose_ext(force_jpg: bool, content_type: str, blob: bytes) -> str:
    if force_jpg:
        return ".jpg"
    ct = (content_type or "").lower()
    if "png" in ct:
        return ".png"
    if "jpeg" in ct or "jpg" in ct:
        return ".jpg"
    if blob.startswith(b"\x89PNG"):
        return ".png"
    return ".jpg"


def save_image(
    client: HttpClient,
    image_url: str,
    dst_dir: str,
    hashes: Set[str],
    speech_id: str,
    seq_counter: List[int],
    recs: List[dict],
    source: str,
    page_url: str,
    caption: str,
    force_jpg_ext: bool,
) -> Optional[str]:
    """
    Saves ONE image as: <ID>_<seq>.jpg (seq starts at 0)
    Returns relative path: "<ID>/<ID>_<seq>.jpg"
    """
    try:
        if is_thumbnail_like(image_url):
            recs.append({"page_url": page_url, "source": source, "image_url": image_url,
                         "status": "skipped-thumb", "local_path": None, "bytes": 0, "sha256": None, "caption": caption})
            return None

        candidates = make_size_variants(image_url)
        blob = None
        ctype = ""
        final_url = None

        for cand in candidates:
            try:
                data, ct = download_image_bytes(client, cand)
                ct_low = (ct or "").lower()

                # accept only raster images
                if ct_low and (not ct_low.startswith("image/") or any(x in ct_low for x in ("svg", "gif", "webp", "bmp", "tif", "tiff"))):
                    continue

                # if content-type missing, sniff basic headers
                if not ct_low:
                    if not (data.startswith(b"\xff\xd8") or data.startswith(b"\x89PNG")):
                        continue

                blob = data
                ctype = ct
                final_url = cand
                break
            except requests.RequestException:
                continue

        if blob is None:
            recs.append({"page_url": page_url, "source": source, "image_url": image_url,
                         "status": "failed-all-variants", "local_path": None, "bytes": 0, "sha256": None, "caption": caption})
            return None

        h = hash_bytes(blob)
        if h in hashes:
            recs.append({"page_url": page_url, "source": source, "image_url": final_url or image_url,
                         "status": "skipped-dup", "local_path": None, "bytes": len(blob), "sha256": h, "caption": caption})
            return None

        os.makedirs(dst_dir, exist_ok=True)

        seq_counter[0] += 1
        ext = choose_ext(force_jpg_ext, ctype, blob)

        filename = f"{speech_id}_{seq_counter[0]}{ext}"
        out_abs = os.path.join(dst_dir, filename)

        with open(out_abs, "wb") as f:
            f.write(blob)

        hashes.add(h)
        recs.append({"page_url": page_url, "source": source, "image_url": final_url or image_url,
                     "status": "saved", "local_path": out_abs, "bytes": len(blob), "sha256": h, "caption": caption})

        rel = os.path.join(speech_id, filename).replace("\\", "/")
        return rel

    except Exception:
        recs.append({"page_url": page_url, "source": source, "image_url": image_url,
                     "status": "failed-exception", "local_path": None, "bytes": 0, "sha256": None, "caption": caption})
        return None


# ---------------------------
# Page processing
# ---------------------------

def process_page(
    client: HttpClient,
    url: str,
    speech_id: str,
    dst_dir: str,
    hashes: Set[str],
    recs: List[dict],
    seq_counter: List[int],
    logical_seen: Set[str],
    source_label: str,
    force_jpg_ext: bool,
) -> Tuple[int, int, List[str], List[str], str, Optional[int], Optional[BeautifulSoup], Optional[int]]:
    """
    Returns:
      found_count, saved_count, rel_paths, captions, final_url, status, soup, declared_count
    """
    soup, status, final_url = fetch_soup(client, url)
    if not soup:
        return 0, 0, [], [], final_url, status, None, None

    declared_count = extract_declared_photos_count(soup)

    rel_paths: List[str] = []
    caps: List[str] = []
    page_seen_keys: Set[str] = set()

    def handle_candidate(u: str, cap: str, pid: Optional[str], save_source: str) -> None:
        if not u or is_thumbnail_like(u):
            return

        page_seen_keys.add(pid or u)

        if pid and pid in logical_seen:
            return

        saved_rel = save_image(
            client=client,
            image_url=u,
            dst_dir=dst_dir,
            hashes=hashes,
            speech_id=speech_id,
            seq_counter=seq_counter,
            recs=recs,
            source=save_source,
            page_url=final_url,
            caption=cap,
            force_jpg_ext=force_jpg_ext,
        )
        if saved_rel:
            rel_paths.append(saved_rel)
            caps.append(cap)
            if pid:
                logical_seen.add(pid)

    used_slider = False
    if source_label == "main":
        for u, cap, pid in iter_slider_images(soup, final_url):
            handle_candidate(u, cap, pid, "main-slider")
        used_slider = len(page_seen_keys) > 0

    if not used_slider:
        for u, cap, pid in iter_html_images(soup, final_url):
            handle_candidate(u, cap, pid, f"{source_label}-html")

    return len(page_seen_keys), len(rel_paths), rel_paths, caps, final_url, status, soup, declared_count


def crawl_photos_pagination(
    client: HttpClient,
    first_photos_url: str,
    speech_id: str,
    dst_dir: str,
    hashes: Set[str],
    recs: List[dict],
    seq_counter: List[int],
    logical_seen: Set[str],
    delay_between_pages: float,
    force_jpg_ext: bool,
) -> Tuple[List[str], List[str], Optional[int]]:
    all_paths: List[str] = []
    all_caps: List[str] = []

    fc, sc, p1, c1, final_url, status, soup, decl = process_page(
        client=client,
        url=first_photos_url,
        speech_id=speech_id,
        dst_dir=dst_dir,
        hashes=hashes,
        recs=recs,
        seq_counter=seq_counter,
        logical_seen=logical_seen,
        source_label="photos",
        force_jpg_ext=force_jpg_ext,
    )
    declared_total_local = decl

    all_paths += p1
    all_caps += c1

    if soup:
        next_urls: List[str] = []

        a_next = soup.find("a", rel=lambda v: v and "next" in v)
        if a_next and a_next.get("href"):
            next_urls.append(norm_url(final_url, a_next["href"]) or "")

        ru_tokens = ("след", "далее", "впер", "старше", "ранее", "позже")
        for a in soup.select(".pagination a, nav a, .pager a, .pages a"):
            t = (a.get_text(" ", strip=True) or "").lower()
            if (("next" in t) or ("older" in t) or any(tok in t for tok in ru_tokens) or t in {">", "»"}) and a.get("href"):
                next_urls.append(norm_url(final_url, a.get("href")) or "")

        seen = set()
        for nx in next_urls:
            if not nx or nx in seen:
                continue
            seen.add(nx)

            fc2, sc2, p2, c2, _, _, soup2, decl2 = process_page(
                client=client,
                url=nx,
                speech_id=speech_id,
                dst_dir=dst_dir,
                hashes=hashes,
                recs=recs,
                seq_counter=seq_counter,
                logical_seen=logical_seen,
                source_label="photos-page",
                force_jpg_ext=force_jpg_ext,
            )
            if decl2 is not None and declared_total_local is None:
                declared_total_local = decl2

            all_paths += p2
            all_caps += c2
            time.sleep(delay_between_pages)

    return all_paths, all_caps, declared_total_local


# ---------------------------
# Strict row construction
# ---------------------------

def empty_row() -> Dict[str, object]:
    # use object type to allow ints; csv writer will stringify
    return {k: "" for k in FIELDNAMES}


# ---------------------------
# Per-ID harvest
# ---------------------------

def harvest_one_id(client: HttpClient, cfg: Config, speech_id_int: int) -> Tuple[Optional[dict], Optional[int], str]:
    """
    Returns: (row or None, status_code_of_main, title_for_logging)
    """
    sid = str(speech_id_int)
    dst_dir = os.path.join(cfg.images_root, sid)
    manifest_path = os.path.join(cfg.manifest_root, f"{sid}.jsonl")
    os.makedirs(cfg.manifest_root, exist_ok=True)

    if cfg.purge_before_save:
        purge_images_dir(dst_dir)

    main_url = urljoin(cfg.base_url, sid)
    photos_url = main_url.rstrip("/") + "/photos"
    order = [("photos", photos_url), ("main", main_url)] if cfg.prefer_photos_page else [("main", main_url), ("photos", photos_url)]

    # Prefetch main to check 404 + parse article content
    pre_soup, pre_status, pre_final = fetch_soup(client, main_url)
    if pre_status == 404:
        remove_dir_if_exists(dst_dir)
        return None, 404, ""

    article_soup = pre_soup
    final_article_url = pre_final or main_url

    recs: List[dict] = []
    hashes: Set[str] = set()
    seq_counter = [-1]  # becomes 0 on first save
    logical_seen: Set[str] = set()

    all_paths: List[str] = []
    all_caps: List[str] = []
    declared_total: Optional[int] = None

    photos_had_any = False

    for label, url in order:
        if label == "main" and cfg.prefer_photos_page and (photos_had_any or (declared_total is not None and cfg.strict_cap_to_declared)):
            break

        fc, sc, paths, caps, final_url, status, soup, decl = process_page(
            client=client,
            url=url,
            speech_id=sid,
            dst_dir=dst_dir,
            hashes=hashes,
            recs=recs,
            seq_counter=seq_counter,
            logical_seen=logical_seen,
            source_label=label,
            force_jpg_ext=cfg.force_jpg_ext,
        )

        if label != "main":
            photos_had_any = photos_had_any or (fc > 0 or sc > 0)

        if decl is not None and declared_total is None:
            declared_total = decl

        if label == "main" and soup and not article_soup:
            article_soup = soup
            final_article_url = final_url

        all_paths += paths
        all_caps += caps

        if label != "main" and soup:
            p_paths, p_caps, decl_from_pages = crawl_photos_pagination(
                client=client,
                first_photos_url=final_url,
                speech_id=sid,
                dst_dir=dst_dir,
                hashes=hashes,
                recs=recs,
                seq_counter=seq_counter,
                logical_seen=logical_seen,
                delay_between_pages=cfg.delay_between_pages,
                force_jpg_ext=cfg.force_jpg_ext,
            )
            if decl_from_pages is not None and declared_total is None:
                declared_total = decl_from_pages
            if p_paths:
                photos_had_any = True
                all_paths += p_paths
                all_caps += p_caps

        time.sleep(cfg.delay_between_pages)

    # strict cap
    if cfg.strict_cap_to_declared and declared_total is not None and len(all_paths) > declared_total:
        extra = all_paths[declared_total:]
        for rel in extra:
            try:
                os.remove(os.path.join(cfg.images_root, rel))
            except Exception:
                pass
        all_paths = all_paths[:declared_total]
        all_caps = all_caps[:declared_total]

    # manifest
    if recs:
        os.makedirs(os.path.dirname(manifest_path), exist_ok=True)
        with open(manifest_path, "w", encoding="utf-8") as mf:
            for r in recs:
                mf.write(json.dumps(r, ensure_ascii=False) + "\n")

    # Extract text/meta used by schema
    title_for_logging = ""
    date_str = month = day = year = tim = ""
    location = ""
    topics: List[str] = []
    full_text = ""
    page_summary = ""

    if article_soup:
        title_for_logging = parse_title(article_soup)
        date_str, month, day, year, tim = parse_date_fields(article_soup)
        location = parse_location(article_soup)
        topics = parse_topics(article_soup)
        full_text = parse_body_text(article_soup)
        page_summary = extract_page_summary(article_soup)

    word_count = len(full_text.split()) if full_text else 0

    saved_images_count = len(all_paths)
    if saved_images_count == 0:
        remove_dir_if_exists(dst_dir)

    if not ((title_for_logging or full_text) or (saved_images_count > 0)):
        return None, pre_status, title_for_logging

    # Build strict row with only schema keys
    row = empty_row()
    row["id"] = sid
    row["url"] = final_article_url or main_url

    row["full_text_word_count"] = word_count
    row["date"] = date_str
    row["year"] = year
    row["month"] = month
    row["day"] = day
    row["time"] = tim

    # Language placement rule (no guessing):
    # RU -> base columns, EN -> *_english columns
    row["location"] = location
    row["page_summary"] = page_summary
    row["declared_topics"] = "|".join(topics) if topics else ""
    row["image_captions"] = json.dumps(all_caps, ensure_ascii=False)

    row["stored_image_filepaths"] = json.dumps(all_paths, ensure_ascii=False)
    row["saved_images_count"] = saved_images_count

    if declared_total is None:
        row["declared_images_count"] = ""
        row["missing_images_count"] = ""
    else:
        row["declared_images_count"] = declared_total
        row["missing_images_count"] = (declared_total - saved_images_count)

    return row, pre_status, title_for_logging


# ---------------------------
# CSV utilities
# ---------------------------

def read_done_ids(csv_path: str) -> Set[str]:
    if not os.path.exists(csv_path):
        return set()
    done = set()
    try:
        with open(csv_path, "r", encoding="utf-8", newline="") as f:
            r = csv.DictReader(f)
            # must match our schema; but tolerate if file exists with 'id'
            for row in r:
                v = (row.get("id") or "").strip()
                if v:
                    done.add(v)
    except Exception:
        return set()
    return done


def read_index_ids(index_csv_path: str) -> Set[str]:
    """
    If index file missing, returns empty set (meaning: scrape all IDs in range).
    """
    if not os.path.exists(index_csv_path):
        print(f"[index] WARNING: {index_csv_path} not found; will scrape ALL IDs in range.")
        return set()

    ids = set()
    try:
        with open(index_csv_path, "r", encoding="utf-8", newline="") as f:
            r = csv.DictReader(f)
            fields = r.fieldnames or []
            key = "id"
            if key is None:
                print("[index] WARNING: index CSV has no 'id' or 'ID' column; ignoring index filter.")
                return set()

            for row in r:
                v = (row.get(key) or "").strip()
                if v:
                    ids.add(v)
    except Exception as e:
        print(f"[index] ERROR reading {index_csv_path}: {e}")
        return set()

    print(f"[index] loaded {len(ids)} IDs from {index_csv_path}")
    return ids


def append_rows(rows: List[dict], csv_path: str) -> None:
    exists = os.path.exists(csv_path)
    with open(csv_path, "a", encoding="utf-8", newline="") as f:
        w = csv.DictWriter(f, fieldnames=FIELDNAMES, extrasaction="raise")
        if not exists:
            w.writeheader()
        for row in rows:
            # Hard safety: ensure row has no extra keys and no missing keys
            if set(row.keys()) != set(FIELDNAMES):
                missing = sorted(set(FIELDNAMES) - set(row.keys()))
                extra = sorted(set(row.keys()) - set(FIELDNAMES))
                raise ValueError(f"Row keys mismatch. missing={missing} extra={extra}")
            w.writerow(row)


# ---------------------------
# Driver
# ---------------------------

def run(cfg: Config) -> None:
    os.makedirs(cfg.manifest_root, exist_ok=True)
    os.makedirs(cfg.images_root, exist_ok=True)

    client = HttpClient(cfg)

    already = read_done_ids(cfg.out_csv)
    index_ids = read_index_ids(cfg.index_csv)

    batch: List[dict] = []

    for i in range(cfg.start_id, cfg.end_id + 1):
        sid = str(i)

        if index_ids and sid not in index_ids:
            continue

        if sid in already:
            print(f"[{sid}] SKIP already in CSV")
            continue

        attempt = 0
        while True:
            try:
                row, status_code, title_for_log = harvest_one_id(client, cfg, i)
                sc = status_code if status_code is not None else "NA"

                if row is not None:
                    batch.append(row)
                    print(f"[{sid}] ok status={sc} title='{(title_for_log or '')[:60]}' saved_images={row['saved_images_count']} declared_images={row['declared_images_count']} missing={row['missing_images_count']}")
                    break

                if isinstance(sc, int) and sc in cfg.block_statuses and attempt < cfg.max_id_retries:
                    wait = cfg.backoff_base * (2 ** attempt) + random.uniform(0, cfg.backoff_jitter)
                    attempt += 1
                    print(f"[{sid}] blocked status={sc}; retry {attempt}/{cfg.max_id_retries} after {wait:.1f}s")
                    time.sleep(wait)
                    continue

                print(f"[{sid}] skipped status={sc} (no meaningful data)")
                remove_dir_if_exists(os.path.join(cfg.images_root, sid))
                break

            except requests.HTTPError as e:
                code = getattr(e.response, "status_code", None)
                print(f"[{sid}] HTTP error status={code if code is not None else 'NA'}: {e}")
                remove_dir_if_exists(os.path.join(cfg.images_root, sid))
                break
            except requests.RequestException as e:
                print(f"[{sid}] NET error: {e}")
                remove_dir_if_exists(os.path.join(cfg.images_root, sid))
                break
            except Exception as e:
                print(f"[{sid}] ERROR: {e}")
                remove_dir_if_exists(os.path.join(cfg.images_root, sid))
                break

        if len(batch) >= 5:
            append_rows(batch, cfg.out_csv)
            print(f"[CSV] wrote {len(batch)} rows -> {cfg.out_csv}")
            batch = []

        time.sleep(cfg.delay_between_ids)

    if batch:
        append_rows(batch, cfg.out_csv)
        print(f"[CSV] wrote {len(batch)} rows -> {cfg.out_csv} (final)")


