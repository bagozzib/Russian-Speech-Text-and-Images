# RU -> EN translation (Argos)
# =========================
def ensure_argos_ru_en():
    from argostranslate import package, translate
    installed = translate.get_installed_languages()
    ru_lang = None
    en_lang = None
    for lang in installed:
        if lang.code == "ru" or "Russian" in lang.name:
            ru_lang = lang
        if lang.code == "en" or "English" in lang.name:
            en_lang = lang

    if ru_lang and en_lang:
        return ru_lang.get_translation(en_lang)

    print("Downloading Argos ru->en model (one-time)...")
    package.update_package_index()
    avail = package.get_available_packages()
    pkgs = [p for p in avail if p.from_code == "ru" and p.to_code == "en"]
    if not pkgs:
        raise RuntimeError("No Argos Russian->English package found.")
    dl_path = pkgs[0].download()
    package.install_from_path(dl_path)

    installed = translate.get_installed_languages()
    ru_lang = next(l for l in installed if l.code == "ru")
    en_lang = next(l for l in installed if l.code == "en")
    return ru_lang.get_translation(en_lang)

def chunk_text(text, max_chars=MAX_CHARS_PER_CHUNK):
    if not isinstance(text, str) or not text.strip():
        return [""]
    words = text.split()
    chunks = []
    cur = []
    cur_len = 0
    for w in words:
        w_len = len(w) + 1
        if cur and cur_len + w_len > max_chars:
            chunks.append(" ".join(cur))
            cur = [w]
            cur_len = len(w)
        else:
            cur.append(w)
            cur_len += w_len
    if cur:
        chunks.append(" ".join(cur))
    return chunks

def translate_text_full(text, translator):
    chunks = chunk_text(text, MAX_CHARS_PER_CHUNK)
    out = []
    for ch in chunks:
        if not ch.strip():
            out.append("")
        else:
            out.append(translator.translate(ch))
    return "\n\n".join(out).strip()

def translate_list(items, translator):
    if not items:
        return []
    out = []
    for x in items:
        s = (x or "").strip()
        out.append(translate_text_full(s, translator) if s else "")
    return out

# =========================
# Speakers extraction (labels before ":" or ";", keep only PERSON via spaCy)
# =========================

DELIMS = ":;"
DELIM_CLASS = re.escape(DELIMS)
MAX_LEN = 180
SPEAKER_RE = re.compile(
    rf"(?m)(?:^|\n|(?<=[.!?])\s+)\s*([^\n{DELIM_CLASS}]{{1,{MAX_LEN}}})\s*([{DELIM_CLASS}])"
)

def speaker_clean_label(raw: str) -> str:
    raw = (raw or "").replace("\u00a0", " ").strip()
    raw = re.sub(r"\s+", " ", raw).strip()
    raw = raw.strip(" \t-–—,.;:()[]{}\"'")
    return raw

def extract_speaker_labels(text: str):
    if not isinstance(text, str) or not text.strip():
        return []
    labels = []
    for m in SPEAKER_RE.finditer(text):
        lab = speaker_clean_label(m.group(1))
        parts = re.split(r"[.!?]\s+", lab)
        lab = speaker_clean_label(parts[-1].strip())
        if lab:
            labels.append(lab)
    # de-dupe preserve order
    return list(dict.fromkeys(labels))

def load_spacy():
    import spacy
    return spacy.load(SPACY_MODEL)

# Cache label->bool to avoid re-running NER on same labels
_speaker_person_cache = {}

def filter_labels_to_person(labels, nlp):
    keep = []
    for lab in labels:
        if lab in _speaker_person_cache:
            ok = _speaker_person_cache[lab]
        else:
            doc = nlp(lab)
            ok = any(ent.label_ == "PERSON" for ent in doc.ents)
            _speaker_person_cache[lab] = ok
        if ok:
            keep.append(lab)
    return keep

