BLOCK_STATUSES_DEFAULT = {403, 429, 503}

IMG_EXT_RE = re.compile(r"\.(?:jpg|jpeg|png)(?:\?|$)", re.I)
SRCSET_PART_RE = re.compile(r"\s*(\S+)(?:\s+(\d+(?:\.\d+)?)(w|x))?\s*")
PHOTO_ID_RE = re.compile(r"\bphoto-(\d+)\b", re.I)


@dataclass
class Config:
    lang: str                       # "ru" or "en"
    base_url: str                   # must end with /
    accept_language: str

    out_csv: str
    index_csv: str
    images_root: str
    manifest_root: str

    start_id: int
    end_id: int

    prefer_photos_page: bool
    strict_cap_to_declared: bool
    purge_before_save: bool
    force_jpg_ext: bool             # enforce .jpg filenames

    delay_between_ids: float
    delay_between_pages: float
    timeout: int

    max_transport_retries: int
    max_id_retries: int
    backoff_base: float
    backoff_jitter: float
    block_statuses: Set[int]

    proxy_mode: str                 # "none" | "static" | "rotating"
    static_proxy: str
    proxy_list: List[str]
    rotate_every_seconds: float

def default_base_and_lang(lang: str) -> Tuple[str, str]:
    """
    Returns (base_url, accept_language)
    """
    lang = (lang or "ru").strip().lower()
    if lang == "en":
        # Prefer EN; allow RU fallback
        return (
            "https://en.kremlin.ru/events/president/transcripts/",
            "en-US,en;q=0.9,ru-RU;q=0.4,ru;q=0.3",
        )
    # RU default; allow EN fallback
    return (
        "https://kremlin.ru/events/president/transcripts/",
        "ru-RU,ru;q=0.9,en-US;q=0.6,en;q=0.4",
    )


def build_headers(accept_language: str) -> Dict[str, str]:
    return {
        "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
            "AppleWebKit/537.36 (KHTML, like Gecko) "
            "Chrome/120.0.0.0 Safari/537.36"
        ),
        "Accept-Language": accept_language,
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "Connection": "keep-alive",
    }


