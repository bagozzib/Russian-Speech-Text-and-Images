MONTHS = {
    "january": "January", "february": "February", "march": "March",
    "april": "April", "may": "May", "june": "June",
    "july": "July", "august": "August", "september": "September",
    "october": "October", "november": "November", "december": "December"
}

def clean_text(s: str) -> str:
    if not s:
        return ""
    return re.sub(r"\s+", " ", str(s)).strip()

def strip_ordinals(s: str) -> str:
    return re.sub(r'(?<=\d)(st|nd|rd|th)\b', '', s, flags=re.I)

def parse_date_parts(date_str: str):
    if not date_str:
        return None, None, None
    s = strip_ordinals(date_str)
    s = clean_text(s)
    s = re.sub(r"[.,]\s*$", "", s)

    m1 = re.match(r"^(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})$", s)
    if m1:
        day = int(m1.group(1))
        mon = MONTHS.get(m1.group(2).lower(), m1.group(2))
        year = int(m1.group(3))
        return mon, day, year

    m2 = re.match(r"^([A-Za-z]+)\s+(\d{1,2})(?:,)?\s+(\d{4})$", s)
    if m2:
        mon = MONTHS.get(m2.group(1).lower(), m2.group(1))
        day = int(m2.group(2))
        year = int(m2.group(3))
        return mon, day, year

    tokens = re.findall(r"[A-Za-z]+|\d{1,4}", s)
    mon, day, year = None, None, None
    for tok in tokens:
        if tok.isdigit():
            if len(tok) == 4 and not year:
                year = int(tok)
            elif not day:
                day = int(tok)
        else:
            if tok.lower() in MONTHS and not mon:
                mon = MONTHS[tok.lower()]
    return mon, day, year

def ensure_dir(path: str):
    os.makedirs(path, exist_ok=True)

def extract_id_from_url(u: str) -> str:
    m = re.search(r"/(\d+)(?:/)?(?:\?.*)?$", str(u).strip())
    return m.group(1) if m else ""

def join_base(url: str) -> str:
    p = urlparse(url)
    return f"{p.scheme}://{p.netloc}"

def safe_read_csv(path: str) -> pd.DataFrame:
    for enc in ("utf-8-sig", "utf-8", "cp1251"):
        try:
            return pd.read_csv(path, encoding=enc)
        except Exception:
            continue
    return pd.read_csv(path)

def detect_index_columns(df: pd.DataFrame):
    cols = {c.lower().strip(): c for c in df.columns}
    id_col = cols.get("id", None)
    url_col = cols.get("url", None)
    if id_col is None or url_col is None:
        raise ValueError(f"Index CSV must have columns including 'ID' and 'url'. Found: {list(df.columns)}")
    return id_col, url_col

def load_done_ids(out_csv: str) -> set:
    if not os.path.isfile(out_csv):
        return set()
    try:
        df = pd.read_csv(out_csv, encoding="utf-8-sig", usecols=["id"], dtype={"id": str})
        return set(df["id"].dropna().astype(str).str.strip().tolist())
    except Exception:
        return set()

def write_rows(out_csv: str, rows, header):
    exists = os.path.isfile(out_csv)
    with open(out_csv, "a", encoding="utf-8-sig", newline="") as f:
        w = csv.DictWriter(f, fieldnames=header)
        if not exists:
            w.writeheader()
        for r in rows:
            w.writerow(r)

def text_word_count(text: str) -> int:
    if not text:
        return 0
    return len(re.findall(r"\w+", text, flags=re.UNICODE))


def fetch_soup(session: requests.Session, url: str) -> BeautifulSoup:
    last_err = None
    for attempt in range(1, RETRIES + 1):
        try:
            time.sleep(REQUEST_DELAY_SEC)
            r = session.get(url, headers=HEADERS, timeout=TIMEOUT)
            r.raise_for_status()
            return BeautifulSoup(r.content, "lxml")
        except Exception as e:
            last_err = e
            time.sleep(min(5.0, attempt * 1.0))
    raise RuntimeError(f"Failed to fetch after {RETRIES} attempts: {url} :: {repr(last_err)}")


def extract_title(soup: BeautifulSoup) -> str:
    title_el = soup.select_one("h1.photo-content__title") or soup.select_one("h1")
    return clean_text(title_el.get_text(" ", strip=True)) if title_el else ""

def extract_date_time(soup: BeautifulSoup):
    date_el = soup.select_one(".photo-content__date")
    time_el = soup.select_one(".photo-content__time")
    date_txt = clean_text(date_el.get_text(strip=True)) if date_el else ""
    time_txt = clean_text(time_el.get_text(strip=True)) if time_el else ""
    return date_txt, time_txt

def extract_full_text(soup: BeautifulSoup) -> str:
    cont = soup.select_one(".text.article-content")
    if not cont:
        return ""
    parts = []
    for p in cont.find_all(["p", "li"]):
        t = clean_text(p.get_text(" ", strip=True))
        if t:
            parts.append(t)
    return " ".join(parts).strip()


# Speaker Extraction
def extract_bold_with_colon(soup: BeautifulSoup):
    scope = soup.select_one(".text.article-content") or soup
    out = []
    seen = set()
    for tag in scope.find_all(["b", "strong"]):
        txt = clean_text(tag.get_text(" ", strip=True))
        if not txt or ":" not in txt:
            continue
        txt = re.sub(r"\s*:\s*", ": ", txt).strip()
        if txt not in seen:
            seen.add(txt)
            out.append(txt)
    return out

def bold_items_to_speaker_names(bold_items):
    out = []
    seen = set()
    for t in bold_items:
        t = clean_text(t)
        if not t:
            continue
        left = t.split(":", 1)[0].strip()
        left = re.sub(r"\s+", " ", left).strip()
        if left and left not in seen:
            seen.add(left)
            out.append(left)
    return out


# Images (photo slider modal)
def pick_img_src(tag) -> str:
    if not tag:
        return ""
    v = tag.get("src") or tag.get("data-src") or ""
    if not v:
        ss = tag.get("srcset")
        if ss:
            first = ss.split(",")[0].strip().split(" ")[0]
            v = first
    return v or ""

def collect_slider_images(soup: BeautifulSoup, base_url: str):
    items = []
    modal = soup.select_one("#photo-slider .photo-slider__list")
    if modal:
        for li in modal.find_all("li"):
            img = li.find("img")
            src = pick_img_src(img)
            if not src:
                continue
            full = urljoin(base_url, src)
            cap = clean_text(img.get("alt", "")) if img else ""
            items.append((full, cap))
    return items

def declared_images_count(soup: BeautifulSoup):
    t = soup.select_one(".photo-slider-popup__total-photos")
    if not t:
        list_ul = soup.select_one("#photo-slider .photo-slider__list")
        if list_ul:
            return len(list_ul.find_all("li"))
        return None
    try:
        return int(re.sub(r"\D+", "", t.get_text(strip=True)))
    except Exception:
        return None

def _sha256_bytes(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()

def save_images(session: requests.Session, id_str: str, img_items, images_root: str):
    """
    Returns:
      stored_paths (list of local file paths),
      captions (list),
      saved_count (int)
    Dedup by content hash within the same ID.
    """
    stored_paths = []
    captions = []
    if not img_items:
        return stored_paths, captions, 0

    folder = os.path.join(images_root, id_str)
    created = False
    seq = 0
    seen_hashes = set()

    for url, cap in img_items:
        try:
            time.sleep(REQUEST_DELAY_SEC)
            r = session.get(url, headers=HEADERS, timeout=TIMEOUT)
            r.raise_for_status()
            data = r.content
            if not data:
                continue

            h = _sha256_bytes(data)
            if h in seen_hashes:
                continue
            seen_hashes.add(h)

            ext = os.path.splitext(urlparse(url).path)[1].lower()
            if ext not in (".jpg", ".jpeg", ".png"):
                ext = ".jpg"

            if not created:
                ensure_dir(folder)
                created = True

            out_name = f"{id_str}_{seq}{ext}"
            out_path = os.path.join(folder, out_name)
            with open(out_path, "wb") as f:
                f.write(data)

            stored_paths.append(out_path)
            captions.append(clean_text(cap))
            seq += 1

        except Exception as e:
            print(f"[{id_str}] image download failed: {url} :: {e}")
            continue

    if created and not stored_paths:
        try:
            os.rmdir(folder)
        except OSError:
            pass

    return stored_paths, captions, len(stored_paths)


# Location inference (title-rule + spaCy NER)
def extract_city_from_title(title):
    if not isinstance(title, str):
        return None
    title = title.strip()
    if not title:
        return None
    parts = [p.strip() for p in title.split(",") if p.strip()]
    if not parts:
        return None
    for seg in reversed(parts):
        if re.search(r"\d", seg):
            continue
        if len(seg.split()) > 6:
            continue
        return seg or None
    return None

def ner_best_location(text, nlp, max_chars=2500):
    if text is None or not isinstance(text, str):
        return None
    text = text.strip()
    if not text:
        return None

    doc = nlp(text[:max_chars])
    candidates = [
        ent.text.strip()
        for ent in doc.ents
        if ent.label_ in ("GPE", "LOC", "FAC")
    ]
    if not candidates:
        return None

    def norm(s):
        return re.sub(r"\s+", " ", s.lower()).strip(" .,")

    counts = Counter(norm(c) for c in candidates)
    best_norm, _ = counts.most_common(1)[0]
    for c in candidates:
        if norm(c) == best_norm:
            return {"raw": c}
    return None

def infer_location_spacy(title_en: str, fulltext_en: str, nlp):
    title = title_en or ""
    full_text = fulltext_en or ""

    title_rule_raw = extract_city_from_title(title)
    title_ner = ner_best_location(title, nlp, max_chars=LOCATION_MAX_CHARS)
    title_ner_raw = title_ner["raw"] if title_ner else None
    full_ner = ner_best_location(full_text, nlp, max_chars=LOCATION_MAX_CHARS)
    full_ner_raw = full_ner["raw"] if full_ner else None

    if title_rule_raw:
        return title_rule_raw
    if title_ner_raw:
        return title_ner_raw
    if full_ner_raw:
        return full_ner_raw
    return ""


# Claude fallback for location
def claude_extract_location_for_one(title: str, text: str) -> str:
    """
    Returns a location string or "" if UNKNOWN.
    """
    if not CLAUDE_API_KEY:
        raise ValueError("CLAUDE_API_KEY is empty. Set env var CLAUDE_API_KEY or paste it into CLAUDE_API_KEY.")

    t = (text or "")
    t = t[:CLAUDE_MAX_TEXT_CHARS]

    prompt_lines = [
        "Extract ONLY the location (city/country) mentioned or implied by this document.",
        "If there is no clear location, output exactly: UNKNOWN",
        "",
        "TITLE:",
        (title or ""),
        "",
        "TEXT:",
        t,
        "",
        "Return ONLY one line: <location_or_UNKNOWN>",
        "Do not add any explanation."
    ]
    user_prompt = "\n".join(prompt_lines)

    payload = {
        "model": CLAUDE_MODEL,
        "max_tokens": 64,
        "system": "You are a precise information extractor. Follow the output format exactly.",
        "messages": [{"role": "user", "content": user_prompt}],
    }
    headers = {
        "x-api-key": CLAUDE_API_KEY,
        "anthropic-version": "2023-06-01",
        "content-type": "application/json",
    }

    r = requests.post(CLAUDE_API_URL, headers=headers, data=json.dumps(payload))
    if r.status_code != 200:
        raise RuntimeError(f"Claude HTTP {r.status_code}: {r.text}")

    data = r.json()
    out = data["content"][0]["text"].strip()
    out = clean_text(out)
    if out.upper() == "UNKNOWN":
        return ""
    return out

def _load_geocode_cache(path: str):
    if not os.path.isfile(path):
        return {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}

def _save_geocode_cache(path: str, cache: dict):
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(cache, f, ensure_ascii=False, indent=2)
    except Exception:
        pass

def geocode_location(location: str, geolocator, cache: dict):
    loc = clean_text(location)
    if not loc:
        return "", ""
    key = loc.lower()
    if key in cache:
        v = cache[key]
        return str(v.get("lat", "")), str(v.get("lon", ""))

    time.sleep(GEOCODE_DELAY_SEC)
    try:
        g = geolocator.geocode(loc)
        if g is None:
            cache[key] = {"lat": "", "lon": ""}
            return "", ""
        cache[key] = {"lat": g.latitude, "lon": g.longitude}
        return str(g.latitude), str(g.longitude)
    except Exception:
        cache[key] = {"lat": "", "lon": ""}
        return "", ""


# RU->EN translation (Argos)
def _init_argos_translator():
    try:
        from argostranslate import translate as argos_translate
        return argos_translate
    except Exception:
        return None

def _translate_text_ru_to_en(argos_translate, text: str) -> str:
    if not argos_translate:
        return ""
    if not text:
        return ""
    t = str(text)[:TRANSLATION_MAX_CHARS]
    try:
        return argos_translate.translate(t, "ru", "en")
    except Exception:
        return ""


# Page -> row
def parse_mid_page(session, url: str, images_root: str, nlp, geolocator, geocode_cache: dict, argos_translate):
    soup = fetch_soup(session, url)
    base_url = join_base(url)

    page_id = extract_id_from_url(url)
    if not page_id:
        raise RuntimeError("Could not parse ID from url")

    title = extract_title(soup)
    date_txt, time_txt = extract_date_time(soup)
    Month, Day, Year = parse_date_parts(date_txt)

    full_text = extract_full_text(soup)
    wc = text_word_count(full_text)

    # speakers (old logic)
    bold_items = extract_bold_with_colon(soup)
    speakers = bold_items_to_speaker_names(bold_items)

    # images
    img_items = collect_slider_images(soup, base_url)
    declared = declared_images_count(soup)
    stored_paths, caps, saved_count = save_images(session, page_id, img_items, images_root)
    missing = ""
    if declared is not None:
        missing = declared - saved_count

    # RU translation (for title_english/full_text_english + location inference input)
    title_en = ""
    full_text_en = ""
    caps_en = []
    if LANG == "ru":
        if not RUN_RU_TRANSLATION:
            raise ValueError("LANG='ru' requires RUN_RU_TRANSLATION=True for your workflow.")
        if argos_translate is None:
            raise ValueError("Argos Translate not available. Install argostranslate and ru->en package.")
        title_en = _translate_text_ru_to_en(argos_translate, title)
        full_text_en = _translate_text_ru_to_en(argos_translate, full_text)
        if TRANSLATE_CAPTIONS_TOO and caps:
            for c in caps:
                caps_en.append(_translate_text_ru_to_en(argos_translate, c))

    # Location inference input:
    # EN: title + full_text
    # RU: title_english + full_text_english
    location = ""
    if RUN_LOCATION_INFERENCE and nlp is not None:
        if LANG == "en":
            location = infer_location_spacy(title, full_text, nlp)
        else:
            location = infer_location_spacy(title_en, full_text_en, nlp)

    # Optional Claude fallback if still blank
    if USE_CLAUDE_FALLBACK_FOR_LOCATION and not location:
        time.sleep(CLAUDE_SLEEP_BETWEEN_CALLS)
        if LANG == "en":
            location = claude_extract_location_for_one(title, full_text)
        else:
            location = claude_extract_location_for_one(title_en, full_text_en)

    # geocoding
    lat, lon = "", ""
    if RUN_GEOCODING and geolocator is not None:
        lat, lon = geocode_location(location, geolocator, geocode_cache)

    # build row (NO curated columns)
    if LANG == "en":
        return {
            "id": page_id,
            "url": url,
            "title": title,
            "full_text": full_text,
            "full_text_word_count": wc,
            "date": date_txt,
            "year": str(Year) if Year is not None else "",
            "month": Month or "",
            "day": str(Day) if Day is not None else "",
            "time": time_txt,
            "location": location,
            "latitude": lat,
            "longitude": lon,
            "speakers": json.dumps(speakers, ensure_ascii=False),
            "stored_image_filepaths": json.dumps(stored_paths, ensure_ascii=False),
            "saved_images_count": saved_count,
            "declared_images_count": declared if declared is not None else "",
            "missing_images_count": missing,
            "image_captions": json.dumps(caps, ensure_ascii=False),
        }

    return {
        "id": page_id,
        "url": url,
        "title": title,
        "title_english": title_en,
        "full_text_english": full_text_en,
        "full_text": full_text,
        "full_text_word_count": wc,
        "date": date_txt,
        "year": str(Year) if Year is not None else "",
        "month": Month or "",
        "day": str(Day) if Day is not None else "",
        "time": time_txt,
        "location": location,
        "latitude": lat,
        "longitude": lon,
        "speakers": json.dumps(speakers, ensure_ascii=False),
        "stored_image_filepaths": json.dumps(stored_paths, ensure_ascii=False),
        "saved_images_count": saved_count,
        "declared_images_count": declared if declared is not None else "",
        "missing_images_count": missing,
        "image_captions": json.dumps(caps, ensure_ascii=False),
        "image_captions_english": json.dumps(caps_en, ensure_ascii=False),
    }


# MAIN
def main():
    if LANG not in ("en", "ru"):
        raise ValueError("LANG must be 'en' or 'ru'")

    if LANG == "en":
        index_csv = INDEX_CSV_EN
        out_csv = OUTPUT_CSV_EN
        images_root = IMAGE_ROOT_EN
        header = OUTPUT_COLUMNS_EN
    else:
        index_csv = INDEX_CSV_RU
        out_csv = OUTPUT_CSV_RU
        images_root = IMAGE_ROOT_RU
        header = OUTPUT_COLUMNS_RU

    if not os.path.isfile(index_csv):
        raise FileNotFoundError(f"Index CSV not found: {index_csv}")

    ensure_dir(images_root)

    # spaCy init
    nlp = None
    if RUN_LOCATION_INFERENCE:
        import spacy
        print(f"[spacy] loading {SPACY_MODEL} ...")
        nlp = spacy.load(SPACY_MODEL)

    # Geocoder init
    geolocator = None
    geocode_cache = {}
    if RUN_GEOCODING:
        try:
            from geopy.geocoders import Nominatim
            geolocator = Nominatim(user_agent="mid_location_geocoder_rakesh")
            geocode_cache = _load_geocode_cache(GEOCODE_CACHE_PATH)
            print(f"[geocode] cache entries loaded: {len(geocode_cache)}")
        except Exception as e:
            print(f"[geocode] could not init geocoder; disabling geocoding. reason={repr(e)}")
            geolocator = None

    # Argos init (RU only)
    argos_translate = None
    if LANG == "ru":
        if RUN_RU_TRANSLATION:
            argos_translate = _init_argos_translator()
            if argos_translate is None:
                raise ValueError("Argos Translate not available. Install argostranslate and ru->en package.")
        else:
            raise ValueError("LANG='ru' requires RUN_RU_TRANSLATION=True for your workflow.")

    # Claude key guard if enabled
    if USE_CLAUDE_FALLBACK_FOR_LOCATION and not CLAUDE_API_KEY:
        raise ValueError("USE_CLAUDE_FALLBACK_FOR_LOCATION=True but CLAUDE_API_KEY is empty.")

    # Read index
    df = safe_read_csv(index_csv)
    id_col, url_col = detect_index_columns(df)
    df[id_col] = df[id_col].astype(str).str.strip()
    df[url_col] = df[url_col].astype(str).str.strip()
    df = df[(df[id_col] != "") & (df[url_col] != "")].copy()

    # Resume
    done = load_done_ids(out_csv)
    if done:
        print(f"[resume] already have {len(done)} ids in {out_csv}")

    batch = []
    processed = 0
    skipped = 0

    with requests.Session() as session:
        for _, r in df.iterrows():
            page_id = str(r[id_col]).strip()
            url = str(r[url_col]).strip()

            if page_id in done:
                skipped += 1
                continue

            try:
                row = parse_mid_page(session, url, images_root, nlp, geolocator, geocode_cache, argos_translate)

                # Force id from index (in case url parse differs)
                row["id"] = page_id

                # Ensure all expected cols exist
                for c in header:
                    if c not in row:
                        row[c] = ""

                batch.append({c: row.get(c, "") for c in header})
                processed += 1
                print(f"[{LANG}] [{page_id}] OK  imgs={row.get('saved_images_count')} loc='{row.get('location','')}'")

                if len(batch) >= CHECKPOINT_EVERY:
                    write_rows(out_csv, batch, header)
                    batch = []
                    if RUN_GEOCODING and geolocator is not None:
                        _save_geocode_cache(GEOCODE_CACHE_PATH, geocode_cache)
                    print(f"[checkpoint] wrote {CHECKPOINT_EVERY} rows -> {out_csv}")

            except Exception as e:
                print(f"[{LANG}] [{page_id}] FAIL url={url} :: {repr(e)}")
                continue

    if batch:
        write_rows(out_csv, batch, header)
        if RUN_GEOCODING and geolocator is not None:
            _save_geocode_cache(GEOCODE_CACHE_PATH, geocode_cache)
        print(f"[final] wrote remaining {len(batch)} rows -> {out_csv}")

    print(f"Done. LANG={LANG} processed={processed} skipped_existing={skipped}")
    print(f"Output: {out_csv}")

if __name__ == "__main__":
    main()
