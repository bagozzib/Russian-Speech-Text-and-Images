def fetch_soup(client: HttpClient, url: str) -> Tuple[Optional[BeautifulSoup], Optional[int], str]:
    # best-effort fast 404 check
    try:
        h = client.request("HEAD", url)
        if h is not None and h.status_code == 404:
            return None, 404, url
    except requests.RequestException:
        pass

    try:
        r = client.request("GET", url)
        status = r.status_code
        final_url = r.url
        ctype = r.headers.get("Content-Type", "")
        if "text/html" not in ctype:
            return None, status, final_url
        if len(r.text or "") < 400:
            return None, status, final_url
        return safe_bs4(r.text), status, final_url
    except requests.RequestException:
        return None, None, url


