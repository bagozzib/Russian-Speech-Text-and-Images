def extract_caption_for_img(img_tag) -> str:
    fig = img_tag.find_parent("figure")
    if fig:
        fc = fig.find("figcaption")
        if fc:
            t = fc.get_text(" ", strip=True)
            if t:
                return t

    alt = (img_tag.get("alt") or "").strip()
    if alt:
        return alt
    title = (img_tag.get("title") or "").strip()
    return title or ""


def pick_photo_id(tag) -> Optional[str]:
    ids = [tag.get("id", ""), " ".join(tag.get("class", []))]
    parent = tag.find_parent(True)
    if parent:
        ids += [parent.get("id", ""), " ".join(parent.get("class", []))]
    for s in ids:
        if not s:
            continue
        m = PHOTO_ID_RE.search(s)
        if m:
            return m.group(1)
    return None


def iter_slider_images(soup: BeautifulSoup, base_url: str) -> Iterable[Tuple[str, str, Optional[str]]]:
    root = soup.select_one(".entry-content.read__internal_content") or soup
    slides = root.select(".slider__slides img")
    seen = set()

    for img in slides:
        cand = img.get("src") or img.get("data-src") or img.get("data-original")
        cand = best_from_srcset(base_url, img.get("srcset") or img.get("data-srcset")) or cand
        u = norm_url(base_url, cand)
        if not u or u in seen:
            continue
        seen.add(u)
        cap = (img.get("data-text") or img.get("alt") or "").strip()
        yield u, cap, pick_photo_id(img)


def iter_html_images(soup: BeautifulSoup, base_url: str) -> Iterable[Tuple[str, str, Optional[str]]]:
    seen = set()
    root = soup.select_one("article") or soup

    for img in root.find_all("img"):
        cand = (
            img.get("src")
            or img.get("data-src")
            or img.get("data-original")
            or img.get("data-original-src")
            or img.get("data-lazy")
        )
        cand = best_from_srcset(base_url, img.get("srcset") or img.get("data-srcset")) or cand
        u = norm_url(base_url, cand)
        if u and u not in seen:
            seen.add(u)
            yield u, extract_caption_for_img(img), pick_photo_id(img)

    for picture in root.find_all("picture"):
        for source in picture.find_all("source"):
            u = best_from_srcset(base_url, source.get("srcset"))
            if u and u not in seen:
                seen.add(u)
                yield u, "", pick_photo_id(source)

    for nos in root.find_all("noscript"):
        nsoup = safe_bs4(nos.get_text() or "")
        for img in nsoup.find_all("img"):
            cand = img.get("src") or img.get("data-src") or img.get("data-original")
            cand = best_from_srcset(base_url, img.get("srcset") or img.get("data-srcset")) or cand
            u = norm_url(base_url, cand)
            if u and u not in seen:
                seen.add(u)
                yield u, extract_caption_for_img(img), pick_photo_id(img)

    for a in root.find_all("a", href=True):
        if IMG_EXT_RE.search(a["href"]):
            u = norm_url(base_url, a["href"])
            if u and u not in seen:
                seen.add(u)
                cap = a.get("title") or a.get_text(" ", strip=True) or ""
                fig = a.find_parent("figure")
                if fig:
                    fc = fig.find("figcaption")
                    if fc:
                        cap = fc.get_text(" ", strip=True) or cap
                yield u, cap, pick_photo_id(a)


