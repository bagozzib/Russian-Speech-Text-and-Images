def parse_args() -> argparse.Namespace:
    ap = argparse.ArgumentParser(description="Scrape Kremlin transcripts + images (RU/EN) with strict CSV schema.")
    ap.add_argument("--lang", choices=["ru", "en"], default="ru", help="Site language: ru or en.")
    ap.add_argument("--base-url", default="", help="Override base URL (must end with /).")

    ap.add_argument("--out-csv", default="kremlin_transcripts_strict.csv")
    ap.add_argument("--index-csv", default="kremlin_transcript_index.csv")
    ap.add_argument("--images-root", default="kremlin_images")
    ap.add_argument("--manifest-root", default="manifests")

    ap.add_argument("--start-id", type=int, default=1)
    ap.add_argument("--end-id", type=int, default=200000)

    ap.add_argument("--prefer-photos-page", type=int, default=0)
    ap.add_argument("--strict-cap-to-declared", type=int, default=1)
    ap.add_argument("--purge-before-save", type=int, default=0)
    ap.add_argument("--force-jpg-ext", type=int, default=1)

    ap.add_argument("--delay-between-ids", type=float, default=9)
    ap.add_argument("--delay-between-pages", type=float, default=9)
    ap.add_argument("--timeout", type=int, default=100)

    ap.add_argument("--max-transport-retries", type=int, default=3)
    ap.add_argument("--max-id-retries", type=int, default=4)
    ap.add_argument("--backoff-base", type=float, default=10)
    ap.add_argument("--backoff-jitter", type=float, default=5)

    # proxies (optional)
    ap.add_argument("--proxy-mode", choices=["none", "static", "rotating"], default="none")
    ap.add_argument("--static-proxy", default=os.getenv("STATIC_PROXY", ""))
    ap.add_argument("--proxy-list", default="", help="Comma-separated proxy URLs for rotating mode.")
    ap.add_argument("--rotate-every-seconds", type=float, default=100)

    return ap.parse_args()


def main() -> None:
    args = parse_args()

    base_default, accept_lang = default_base_and_lang(args.lang)
    base_url = (args.base_url.strip() or base_default).strip()
    if not base_url.endswith("/"):
        base_url += "/"

    proxy_list = [p.strip() for p in (args.proxy_list or "").split(",") if p.strip()]

    cfg = Config(
        lang=args.lang,
        base_url=base_url,
        accept_language=accept_lang,

        out_csv=args.out_csv,
        index_csv=args.index_csv,
        images_root=args.images_root,
        manifest_root=args.manifest_root,

        start_id=args.start_id,
        end_id=args.end_id,

        prefer_photos_page=bool(args.prefer_photos_page),
        strict_cap_to_declared=bool(args.strict_cap_to_declared),
        purge_before_save=bool(args.purge_before_save),
        force_jpg_ext=bool(args.force_jpg_ext),

        delay_between_ids=args.delay_between_ids,
        delay_between_pages=args.delay_between_pages,
        timeout=args.timeout,

        max_transport_retries=args.max_transport_retries,
        max_id_retries=args.max_id_retries,
        backoff_base=args.backoff_base,
        backoff_jitter=args.backoff_jitter,
        block_statuses=set(BLOCK_STATUSES_DEFAULT),

        proxy_mode=args.proxy_mode,
        static_proxy=args.static_proxy,
        proxy_list=proxy_list,
        rotate_every_seconds=args.rotate_every_seconds,
    )

    print(f"[config] lang={cfg.lang} base_url={cfg.base_url}")
    print(f"[config] image naming: <ID>_<seq>.jpg inside {cfg.images_root}/<ID>/")
    print(f"[config] CSV columns: {len(FIELDNAMES)} (strict, exact user schema)")

    run(cfg)


if __name__ == "__main__":
    main()
