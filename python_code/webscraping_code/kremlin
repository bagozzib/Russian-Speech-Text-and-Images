def sleep_a_bit():
    time.sleep(DELAY_BETWEEN_IDS + random.uniform(*DELAY_JITTER))

def clean_text(s):
    if not s:
        return ""
    s = html.unescape(s)
    s = re.sub(r"\r\n|\r", "\n", s)
    s = re.sub(r"[ \t\u00A0]+", " ", s)
    s = re.sub(r"\n{3,}", "\n\n", s)
    return s.strip()

def safe_int(x):
    try:
        return int(x)
    except Exception:
        return None

def request_get(url, timeout=TIMEOUT, retries=RETRIES):
    last = None
    for _ in range(retries):
        try:
            r = session.get(url, headers=HEADERS, timeout=timeout, allow_redirects=True)
            if r.status_code == 404:
                return r
            r.raise_for_status()
            return r
        except requests.RequestException as e:
            last = e
            sleep_a_bit()
    if last:
        raise last
    return None

def fetch_soup(url):
    try:
        r = request_get(url)
        if r is None:
            return None, None
        if r.status_code == 404:
            return None, 404
        ct = (r.headers.get("Content-Type","") or "").lower()
        if "text/html" not in ct and "<html" not in (r.text[:500].lower() if r.text else ""):
            return None, r.status_code
        return BeautifulSoup(r.text, "lxml"), r.status_code
    except Exception:
        return None, None

def parse_title(soup):
    for sel in ['h1[itemprop="headline"]', "h1.entry-title", "h1.post__title", "article h1", "h1"]:
        el = soup.select_one(sel)
        if el and el.get_text(strip=True):
            return el.get_text(" ", strip=True)
    return ""

def parse_date_fields(soup):
    """
    Output:
      date = YYYY-MM-DD (ISO)
      year/month/day = integers
      time = HH:MM if present
    """
    dt = None
    t = soup.select_one("time.read__published[datetime]")
    if t and t.get("datetime"):
        try:
            dt = dateparser.parse(t["datetime"].strip())
        except Exception:
            dt = None

    tim = ""
    tdiv = soup.select_one("div.read__time")
    if tdiv and tdiv.get_text(strip=True):
        tim = tdiv.get_text(strip=True)

    if not dt:
        for sel in ["time[datetime]", ".entry-meta", ".post__meta", ".time", ".posted-on", ".material__info"]:
            el = soup.select_one(sel)
            if el and el.get_text(strip=True):
                try:
                    dt = dateparser.parse(el.get_text(" ", strip=True), fuzzy=True)
                    break
                except Exception:
                    pass

    date_iso = ""
    year = month = day = None
    if dt:
        date_iso = dt.date().isoformat()
        year, month, day = dt.year, dt.month, dt.day
        if not tim:
            try:
                tim = dt.strftime("%H:%M")
            except Exception:
                tim = ""
    return date_iso, year, month, day, tim

def parse_location(soup):
    for el in soup.select(".read__place.p-location, .p-location, .read__place, [itemprop='location'], [itemprop='contentLocation']"):
        for i_tag in el.find_all("i"):
            i_tag.decompose()
        txt = el.get_text(" ", strip=True)
        txt = re.sub(r'^[«“"]\s*(.*?)\s*[»”"]$', r"\1", txt).strip()
        if txt and "publication date" not in txt.lower():
            return txt
    return ""

def extract_page_summary(soup):
    md = soup.find("meta", attrs={"name":"description"})
    if md and md.get("content") and md["content"].strip():
        return md["content"].strip()
    for sel in [".lead", ".intro", ".standfirst", ".summary", ".read__lead"]:
        el = soup.select_one(sel)
        if el and el.get_text(strip=True):
            return el.get_text(" ", strip=True)
    return ""

def strip_noise_blocks(soup):
    for selector in [
        ".read__bottommeta",
        ".read__tags",
        ".read__status",
        ".hidden-copy",
        "nav","aside","script","style",
        ".breadcrumbs",".share",".social"
    ]:
        for el in soup.select(selector):
            try:
                el.decompose()
            except Exception:
                pass

def parse_body_text(soup):
    # copy soup so we don't mutate original for tag extraction
    soup2 = BeautifulSoup(str(soup), "lxml")
    strip_noise_blocks(soup2)

    body = None
    for sel in [
        '[itemprop="articleBody"]',
        "article .entry-content",
        "article .post__text",
        "article .text",
        "article",
        ".content",
    ]:
        el = soup2.select_one(sel)
        if el:
            body = el
            break

    if body:
        parts = []
        for tag in body.find_all(["p", "li", "blockquote", "h2", "h3"], recursive=True):
            txt = tag.get_text(" ", strip=True)
            if txt:
                parts.append(txt)
        return clean_text("\n".join(parts))

    return clean_text(soup2.get_text("\n", strip=True))

