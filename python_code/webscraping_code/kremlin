def read_index_ids(index_csv):
    df = pd.read_csv(index_csv, dtype=str)
    # accept "ID" or "id" (index file described as page,ID,url)
    col = None
    for c in df.columns:
        if c.strip().lower() == "id":
            col = c
            break
    if col is None:
        raise ValueError(f"Index CSV must contain an ID column. Found columns: {list(df.columns)}")
    ids = df[col].dropna().astype(str).str.strip()
    ids = [x for x in ids if x]
    # keep order, de-dupe
    return list(dict.fromkeys(ids))

def done_ids(out_csv):
    if not os.path.exists(out_csv):
        return set()
    try:
        df = pd.read_csv(out_csv, usecols=["id"], dtype=str)
        return set(df["id"].dropna().astype(str).str.strip())
    except Exception:
        return set()

def write_rows_append(out_csv, rows):
    exists = os.path.exists(out_csv)
    with open(out_csv, "a", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=OUT_COLS)
        if not exists:
            w.writeheader()
        for r in rows:
            w.writerow(r)

def to_csv_cell(value, fieldname):
    # store lists as JSON strings
    if fieldname in LIST_FIELDS:
        if value is None:
            return "[]"
        if isinstance(value, str):
            # assume already serialized
            return value
        return json.dumps(value, ensure_ascii=False)
    return value if value is not None else ""

# =========================
# MAIN SCRAPE FOR ONE ID
# =========================
def build_url_for_id(id_str):
    return urljoin(BASE_PAGE_URL_BY_LANG[LANG], str(id_str).strip())

def scrape_one(id_str, translator=None, nlp=None):
    url = build_url_for_id(id_str)
    soup, status = fetch_soup(url)
    if status == 404 or soup is None:
        return None

    # core
    title = parse_title(soup)
    date_iso, year, month, day, tim = parse_date_fields(soup)
    location = parse_location(soup)
    page_summary = extract_page_summary(soup)
    full_text = parse_body_text(soup)
    full_text_wc = len(full_text.split()) if full_text else 0

    # declared tags
    geo, topics, persons = extract_declared_tags(soup)

    # images
    images_root = IMAGES_ROOT_BY_LANG[LANG]
    images_dir = os.path.join(images_root, str(id_str))
    photos_url = url.rstrip("/") + "/photos"
    stored_paths, img_caps, declared_count = scrape_images_for_id(url, photos_url, images_dir, str(id_str))

    saved_count = len(stored_paths)
    declared_images_count = declared_count if declared_count is not None else ""
    missing_images_count = (declared_count - saved_count) if (declared_count is not None) else ""

    # speakers
    speakers_list = []
    if EXTRACT_SPEAKERS and nlp is not None:
        if LANG == "en":
            labels = extract_speaker_labels(full_text)
            speakers_list = filter_labels_to_person(labels, nlp)
        else:
            # RU: speakers come from translated full text (later, after translation)
            speakers_list = []

    row = {
        "id": str(id_str),
        "url": url,
        "title": title,
        "full_text": full_text,
        "full_text_word_count": full_text_wc,
        "date": date_iso,
        "year": year if year is not None else "",
        "month": month if month is not None else "",
        "day": day if day is not None else "",
        "time": tim or "",
        "location": location,
        "latitude": "",
        "longitude": "",
        "page_summary": page_summary,
        "speakers": speakers_list,
        "declared_geography": geo,
        "declared_topics": topics,
        "declared_persons": persons,
        "stored_image_filepaths": stored_paths,
        "saved_images_count": saved_count,
        "declared_images_count": declared_images_count,
        "missing_images_count": missing_images_count,
        "image_captions": img_caps,
    }

    # RU translations (only if LANG="ru")
    if LANG == "ru":
        if DO_RU_TRANSLATION and translator is None:
            raise RuntimeError("Translator is required for RU but is None.")

        # translate required scalar fields
        title_en = translate_text_full(title, translator) if title else ""
        full_text_en = translate_text_full(full_text, translator) if full_text else ""
        location_en = translate_text_full(location, translator) if location else ""
        summary_en = translate_text_full(page_summary, translator) if page_summary else ""

        # translate list fields while keeping list structure
        geo_en = translate_list(geo, translator) if geo else []
        topics_en = translate_list(topics, translator) if topics else []
        persons_en = translate_list(persons, translator) if persons else []
        caps_en = translate_list(img_caps, translator) if (TRANSLATE_IMAGE_CAPTIONS and img_caps) else []

        row["title_english"] = title_en
        row["full_text_english"] = full_text_en
        row["location_english"] = location_en
        row["page_summary_english"] = summary_en
        row["declared_geography_english"] = geo_en
        row["declared_topics_english"] = topics_en
        row["declared_persons_english"] = persons_en
        row["image_captions_english"] = caps_en

        # speakers for RU from translated full text
        if EXTRACT_SPEAKERS and nlp is not None:
            labels = extract_speaker_labels(full_text_en)
            row["speakers"] = filter_labels_to_person(labels, nlp)

    # finalize: convert list fields to JSON strings for CSV
    out = {}
    for c in OUT_COLS:
        out[c] = to_csv_cell(row.get(c), c)
    return out

def geocode_fill(out_csv, location_col="location"):
    try:
        from geopy.geocoders import Nominatim, ArcGIS
        from geopy.exc import GeocoderTimedOut, GeocoderUnavailable, GeocoderServiceError
    except Exception:
        print("geopy not installed. Install: pip install geopy")
        return

    df = pd.read_csv(out_csv, dtype=str)
    if "latitude" not in df.columns:
        df["latitude"] = ""
    if "longitude" not in df.columns:
        df["longitude"] = ""

    nominatim = Nominatim(user_agent="kremlin_locations_geocoder")
    arcgis = ArcGIS()

    def cascade(addr: str):
        try:
            loc = nominatim.geocode(addr, timeout=10)
        except (GeocoderTimedOut, GeocoderUnavailable, GeocoderServiceError):
            loc = None
        except Exception:
            loc = None
        if loc:
            return loc.latitude, loc.longitude

        short = addr if len(addr) <= 300 else addr[:300]
        try:
            loc2 = arcgis.geocode(short, timeout=10)
        except (GeocoderTimedOut, GeocoderUnavailable, GeocoderServiceError):
            loc2 = None
        except Exception:
            loc2 = None
        if loc2:
            return loc2.latitude, loc2.longitude

        return None, None

    loc_series = df[location_col].fillna("").astype(str).str.strip()
    uniq = sorted({x for x in loc_series if x})

    cache = {}
    for i, loc in enumerate(uniq, 1):
        if loc in cache:
            continue
        lat, lon = cascade(loc)
        cache[loc] = (lat, lon)
        print(f"[{i}/{len(uniq)}] {loc} -> {lat}, {lon}")
        time.sleep(GEOCODE_SLEEP_SECONDS)

    def get_lat(v):
        s = (v or "").strip()
        return cache.get(s, (None, None))[0] if s else None

    def get_lon(v):
        s = (v or "").strip()
        return cache.get(s, (None, None))[1] if s else None

    df["latitude"] = df[location_col].apply(get_lat)
    df["longitude"] = df[location_col].apply(get_lon)

    df.to_csv(out_csv, index=False, encoding="utf-8-sig")
    print(f"[geocode] updated lat/lon in {out_csv}")

def main():
    index_csv = INDEX_CSV_BY_LANG[LANG]
    out_csv = OUT_CSV_BY_LANG[LANG]
    os.makedirs(IMAGES_ROOT_BY_LANG[LANG], exist_ok=True)

    ids = read_index_ids(index_csv)
    done = done_ids(out_csv)

    translator = None
    if LANG == "ru" and DO_RU_TRANSLATION:
        try:
            translator = ensure_argos_ru_en()
        except Exception as e:
            print("Argos translate not ready.")
            print("Install: pip install argostranslate")
            raise

    nlp = None
    if EXTRACT_SPEAKERS:
        try:
            nlp = load_spacy()
        except Exception:
            print("spaCy model not ready.")
            print("Install:")
            print("  pip install -U spacy")
            print(f"  python -m spacy download {SPACY_MODEL}")
            raise

    batch = []
    for k, id_str in enumerate(ids, 1):
        if id_str in done:
            continue

        print(f"[{k}/{len(ids)}] scraping ID={id_str}")
        row = scrape_one(id_str, translator=translator, nlp=nlp)
        if row:
            batch.append(row)

        if len(batch) >= 25:
            write_rows_append(out_csv, batch)
            print(f"[csv] wrote {len(batch)} rows -> {out_csv}")
            for r in batch:
                done.add(r["id"])
            batch = []

        sleep_a_bit()

    if batch:
        write_rows_append(out_csv, batch)
        print(f"[csv] wrote {len(batch)} rows -> {out_csv} (final)")

    if RUN_GEOCODING:
        geocode_fill(out_csv, location_col="location")

    print("[done]")

if __name__ == "__main__":
    main()
