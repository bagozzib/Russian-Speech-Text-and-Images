def parse_title(soup: BeautifulSoup) -> str:
    for sel in ['h1[itemprop="headline"]', "h1.entry-title", "h1.post__title", "article h1", "h1"]:
        el = soup.select_one(sel)
        if el and el.get_text(strip=True):
            return el.get_text(" ", strip=True)
    return ""


def parse_date_fields(soup: BeautifulSoup) -> Tuple[str, str, str, str, str]:
    """
    Prefer machine-readable time[datetime].
    """
    dt = None
    t = soup.select_one("time[datetime]")
    if t and t.get("datetime"):
        try:
            dt = dateparser.parse(t["datetime"].strip())
        except Exception:
            dt = None

    tim = ""
    tdiv = soup.select_one("div.read__time")
    if tdiv and tdiv.get_text(strip=True):
        tim = tdiv.get_text(strip=True)

    if not dt:
        for el in soup.select("time[datetime]"):
            try:
                dt = dateparser.parse((el.get("datetime") or "").strip())
                if dt:
                    break
            except Exception:
                pass

    date_str = month = day = year = ""
    if dt:
        month = dt.strftime("%B")
        day = str(dt.day)
        year = str(dt.year)
        date_str = f"{month} {day}, {year}"
        if not tim:
            tim = dt.strftime("%H:%M")
    return date_str, month, day, year, tim


def parse_location(soup: BeautifulSoup) -> str:
    for el in soup.select(".read__place.p-location, .p-location, .read__place, [itemprop='location'], [itemprop='contentLocation']"):
        for i_tag in el.find_all("i"):
            i_tag.decompose()
        txt = el.get_text(" ", strip=True)
        txt = re.sub(r'^[«“"]\s*(.*?)\s*[»”"]$', r"\1", txt).strip()
        if txt and "publication date" not in txt.lower():
            return txt
    return ""


def parse_topics(soup: BeautifulSoup) -> List[str]:
    for sel in [".read__tags a", "section.tags a", ".post__tags a", ".tags a", "a[rel='tag']"]:
        tags = [a.get_text(" ", strip=True) for a in soup.select(sel) if a.get_text(strip=True)]
        if tags:
            return tags
    return []


def strip_noise_blocks(soup: BeautifulSoup) -> None:
    for selector in [
        ".read__bottommeta",
        ".read__tags",
        ".read__status",
        ".hidden-copy",
        "nav",
        "aside",
        "script",
        "style",
        ".breadcrumbs",
        ".share",
        ".social",
    ]:
        for el in soup.select(selector):
            try:
                el.decompose()
            except Exception:
                pass


def parse_body_text(soup: BeautifulSoup) -> str:
    """
    Extract full text to compute word count.
    """
    strip_noise_blocks(soup)
    body = None
    for sel in [
        '[itemprop="articleBody"]',
        "article .entry-content",
        "article .post__text",
        "article .text",
        "article",
        ".content",
    ]:
        el = soup.select_one(sel)
        if el:
            body = el
            break

    if body:
        parts: List[str] = []
        for tag in body.find_all(["p", "li", "blockquote", "h2", "h3"], recursive=True):
            txt = tag.get_text(" ", strip=True)
            if txt:
                parts.append(txt)
        return strip_trailing_garbage(clean_text("\n".join(parts)))

    return strip_trailing_garbage(clean_text(soup.get_text("\n", strip=True)))


def extract_page_summary(soup: BeautifulSoup) -> str:
    md = soup.find("meta", attrs={"name": "description"})
    if md and md.get("content") and md["content"].strip():
        return md["content"].strip()
    for sel in [".lead", ".intro", ".standfirst", ".summary", ".read__lead"]:
        el = soup.select_one(sel)
        if el and el.get_text(strip=True):
            return el.get_text(" ", strip=True)
    return ""


def extract_declared_photos_count(soup: BeautifulSoup) -> Optional[int]:
    """
    The photo tab counter is numeric on both RU/EN.
    """
    el = soup.select_one(".tabs_photo .tabs__count")
    if el:
        m = re.search(r"(\d+)", (el.get_text(" ", strip=True) or ""))
        if m:
            return int(m.group(1))

    el = soup.select_one(".read__length")
    if el:
        m = re.search(r"(\d+)", (el.get_text(" ", strip=True) or ""))
        if m:
            return int(m.group(1))

    el = soup.select_one(".read__status .tabs__count")
    if el:
        m = re.search(r"(\d+)", (el.get_text(" ", strip=True) or ""))
        if m:
            return int(m.group(1))

    return None


