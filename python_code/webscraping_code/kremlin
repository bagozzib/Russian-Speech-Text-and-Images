def clean_label(text: str) -> str:
    if not text:
        return ""
    return " ".join(text.split()).strip()

def join_unique_keep_order(lst):
    if not lst:
        return []
    seen = set()
    out = []
    for x in lst:
        x = clean_label(x)
        if x and x not in seen:
            seen.add(x)
            out.append(x)
    return out

def extract_declared_tags(soup):
    """
    Returns: (geo_list, topics_list, persons_list)
    Uses Kremlin tags block structure (read__bottommeta/read__tags/read__tagscol).
    Works for EN/RU by matching headings substrings.
    """
    geo, topics, persons = [], [], []

    bottom = soup.select_one("div.read__bottommeta")
    if not bottom:
        return geo, topics, persons

    tags_block = bottom.select_one("div.read__tags")
    if not tags_block:
        return geo, topics, persons

    for col in tags_block.select("div.read__tagscol"):
        h3 = col.find("h3")
        if not h3:
            continue

        heading = clean_label(h3.get_text(" ", strip=True)).lower()

        is_geo = ("geograph" in heading) or ("географ" in heading)
        is_topics = ("topic" in heading) or ("тем" in heading)
        is_persons = ("person" in heading) or ("персон" in heading) or ("лица" in heading)

        items = []
        for a in col.select("ul.read__taglist li a"):
            lab = clean_label(a.get_text(" ", strip=True))
            if lab:
                items.append(lab)

        if is_geo:
            geo.extend(items)
        elif is_topics:
            topics.extend(items)
        elif is_persons:
            persons.extend(items)

    return join_unique_keep_order(geo), join_unique_keep_order(topics), join_unique_keep_order(persons)

IMG_EXT_RE = re.compile(r"\.(?:jpg|jpeg|png)(?:\?|$)", re.I)

def norm_url(base_url, u):
    if not u:
        return None
    u = html.unescape(u.strip()).strip("'\"")
    if u.startswith("//"):
        u = "http:" + u
    return urljoin(base_url, u)

def extract_caption_for_img(img):
    fig = img.find_parent("figure")
    if fig:
        fc = fig.find("figcaption")
        if fc:
            t = fc.get_text(" ", strip=True)
            if t:
                return t
    alt = (img.get("alt") or "").strip()
    if alt:
        return alt
    title = (img.get("title") or "").strip()
    return title or ""

def extract_declared_photos_count(soup):
    """
    EN pages often show "N photos"
    RU pages may show variants; we match both.
    """
    text = ""
    el = soup.select_one(".read__length")
    if el:
        text = el.get_text(" ", strip=True)
    if not text:
        el = soup.select_one(".tabs_photo .tabs__count")
        if el:
            text = el.get_text(" ", strip=True)

    if not text:
        return None

    # EN: "12 photos"
    m = re.search(r"(\d+)\s+photos?", text, re.I)
    if m:
        return int(m.group(1))

    # RU common: "12 фото"
    m2 = re.search(r"(\d+)\s+фото", text, re.I)
    if m2:
        return int(m2.group(1))

    return None

def iter_html_images(soup, base_url):
    seen = set()
    root = soup.select_one("article") or soup

    for img in root.find_all("img"):
        cand = img.get("src") or img.get("data-src") or img.get("data-original")
        u = norm_url(base_url, cand)
        if u and u not in seen:
            seen.add(u)
            yield u, extract_caption_for_img(img)

    for a in root.find_all("a", href=True):
        if IMG_EXT_RE.search(a["href"]):
            u = norm_url(base_url, a["href"])
            if u and u not in seen:
                seen.add(u)
                cap = a.get("title") or a.get_text(" ", strip=True) or ""
                yield u, cap

def download_image(url, out_path):
    r = request_get(url, timeout=TIMEOUT, retries=RETRIES)
    if r is None or r.status_code == 404:
        return False
    ct = (r.headers.get("Content-Type","") or "").lower()
    if not ct.startswith("image/"):
        return False
    with open(out_path, "wb") as f:
        f.write(r.content)
    return True

def scrape_images_for_id(page_url, photos_url, images_dir, id_str):
    """
    Returns:
      stored_paths(list), captions(list), declared_count(int|None)
    """
    stored_paths, caps = [], []
    declared = None

    if not DOWNLOAD_IMAGES:
        return stored_paths, caps, declared

    os.makedirs(images_dir, exist_ok=True)

    # main page
    soup, _ = fetch_soup(page_url)
    if soup:
        declared = extract_declared_photos_count(soup)
        seq = 0
        for u, cap in iter_html_images(soup, page_url):
            seq += 1
            ext = ".jpg"
            if u.lower().endswith(".png"):
                ext = ".png"
            out_path = os.path.join(images_dir, f"{id_str}_{seq}{ext}")
            ok = download_image(u, out_path)
            if ok:
                stored_paths.append(out_path)
                caps.append(cap)

    # photos page (often has more)
    soup_p, _ = fetch_soup(photos_url)
    if soup_p and declared is None:
        declared = extract_declared_photos_count(soup_p)

    if soup_p:
        # continue seq
        seq = len(stored_paths)
        for u, cap in iter_html_images(soup_p, photos_url):
            seq += 1
            ext = ".jpg"
            if u.lower().endswith(".png"):
                ext = ".png"
            out_path = os.path.join(images_dir, f"{id_str}_{seq}{ext}")
            ok = download_image(u, out_path)
            if ok:
                stored_paths.append(out_path)
                caps.append(cap)

    # cap to declared
    if declared is not None and len(stored_paths) > declared:
        # delete extras from disk to match declared
        for p in stored_paths[declared:]:
            try:
                os.remove(p)
            except Exception:
                pass
        stored_paths = stored_paths[:declared]
        caps = caps[:declared]

    return stored_paths, caps, declared

